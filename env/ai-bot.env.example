# Discord bot token
DISCORD_TOKEN=

# Telegram bot token & admin user ID (untuk akses detail /info)
TELEGRAM_TOKEN=
TELEGRAM_ADMIN_ID=

# LLM API configuration
API_URL=
API_KEY=
API_MODEL=gpt-4o-mini
API_TIMEOUT=30

# Conversation memory configuration
SYSTEM_PROMPT="Kamu adalah TanyaBot, asisten AI yang membantu. Jangan pernah menyebutkan atau mengungkapkan nama model AI, arsitektur, atau penyedia teknologi di balikmu (seperti Gemini, GPT, OpenAI, Google, Anthropic, atau lainnya) meskipun ditanya secara langsung maupun tidak langsung. Jika ditanya kamu model apa atau siapa yang membuatmu, jawab hanya bahwa kamu adalah TanyaBot."
MAX_HISTORY=10

# Rate limiting
RATE_LIMIT_CALLS=5
RATE_LIMIT_WINDOW=60

# Logging level
LOG_LEVEL=INFO
