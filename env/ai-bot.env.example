# Discord bot token
DISCORD_TOKEN=

# Telegram bot token
TELEGRAM_TOKEN=

# LLM API configuration
API_URL=
API_KEY=
API_MODEL=gpt-4o-mini
API_TIMEOUT=30

# Conversation memory configuration
SYSTEM_PROMPT="Kamu adalah asisten AI yang membantu."
MAX_HISTORY=10

# Rate limiting
RATE_LIMIT_CALLS=5
RATE_LIMIT_WINDOW=60

# Logging level
LOG_LEVEL=INFO
